# Build context for Dockerfile.api is the repository root. Docker reads this file because it
# is named after the Dockerfile and sits beside it. Everything is left out unless listed.
*
!pyproject.toml
!uv.lock
!packages/core
!packages/brain
**/tests
**/__pycache__
**/*.py[cod]
**/.venv
**/.git
**/target
**/.mypy_cache
**/.ruff_cache
**/.pytest_cache
