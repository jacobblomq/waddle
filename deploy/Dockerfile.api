# waddle-api: the brain's link server. CPU only; holds no GPU libraries and no Qt.
# Build context is the repository root (see docker-compose.yml); the ignore file next to
# this one, Dockerfile.api.dockerignore, lets in only the two packages and the lock file.
#
# UNVERIFIED (spike S3.1): not built yet; there was no docker daemon where this was written.
# The uv command below was run outside docker against the same four inputs.

FROM python:3.13-slim AS build
COPY --from=ghcr.io/astral-sh/uv:0.11.32 /uv /usr/local/bin/uv
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_NO_CACHE=1
WORKDIR /src
COPY pyproject.toml uv.lock ./
COPY packages/core packages/core
COPY packages/brain packages/brain
# Exactly the locked versions; waddle-core and waddle-brain are installed as real packages
# (not editable), so the final image needs nothing from /src.
RUN uv sync --frozen --no-dev --no-editable --package waddle-brain

FROM python:3.13-slim
COPY --from=build /opt/venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/tmp
# Compose replaces this with your own UID so the socket in the runtime directory is yours.
USER 65534:65534
ENTRYPOINT ["waddle-brain", "--config", "/etc/waddle/brain.toml"]
